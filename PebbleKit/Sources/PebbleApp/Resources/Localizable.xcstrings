            "state" : "machine_translated",
            "value" : "%1$@ はタイムラインを消去しませんでした。%2$@"
          }
        }
      }
    },
    "%@ has no weather app, so nothing is sent to it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”には天気アプリがないため、何も送信しません。"
