      }
    },
    "This firmware does not support it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このファームウェアでは対応していません。"
          }
        }
      }
    },
    "This firmware has nowhere to keep it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "このファームウェアには保存先がありません。"
