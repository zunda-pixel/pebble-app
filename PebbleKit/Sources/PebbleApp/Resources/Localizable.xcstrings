    },
    "%@ did not clear its timeline. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ did not clear its timeline. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ はタイムラインを消去しませんでした。%2$@"
