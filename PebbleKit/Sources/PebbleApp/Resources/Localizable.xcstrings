{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ could not be downloaded right now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま“%@”をダウンロードできませんでした。"
          }
        }
      }
    },
    "%@ could not be installed. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be installed. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をインストールできませんでした。%@"
          }
        }
      }
    },
    "%@ did not accept the forecast. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ did not accept the forecast. %2$@"
