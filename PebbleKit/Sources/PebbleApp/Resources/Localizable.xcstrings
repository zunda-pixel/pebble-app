          }
        }
      }
    },
    "Weather for where the phone is, rather than a place typed in by hand." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "手入力した地点ではなく、iPhoneがある場所の天気を表示します。"
