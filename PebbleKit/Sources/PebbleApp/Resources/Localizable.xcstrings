        }
      }
    },
    "The applications and their settings will be removed. A Pebble that is not connected is told the next time it is." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アプリケーションとその設定を削除します。接続していないPebbleには、次に接続したときに伝えます。"
          }
        }
