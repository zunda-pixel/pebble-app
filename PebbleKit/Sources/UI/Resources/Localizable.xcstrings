          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "テスト通知を送信できませんでした。"
          }
        }
      }
    },
    "The watch cannot be used until this finishes. Keep it nearby and connected." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "完了するまでウォッチは使用できません。接続したまま近くに置いてください。"
          }
        }
      }
    },
    "The watch connection failed. Move the watch closer and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
