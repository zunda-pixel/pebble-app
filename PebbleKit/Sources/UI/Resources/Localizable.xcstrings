  "strings" : {
    "%@ · %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ · %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ could not be downloaded right now." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま“%@”をダウンロードできませんでした。"
          }
        }
      }
    },
    "%@ could not be installed. %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ could not be installed. %2$@"
