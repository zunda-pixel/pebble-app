        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”の予報を取得できませんでした。%@"
          }
        }
      }
    },
    "The forecast for %@ was refused by WeatherKit. Check that this app's identifier has the WeatherKit capability, which can take up to half an hour to take effect." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”の予報がWeatherKitに拒否されました。このアプリのIdentifierでWeatherKitが有効になっているか確認してください（反映まで最大30分かかります）。"
          }
        }
      }
    },
    "The install stopped" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "インストールが停止しました"
          }
        }
      }
    },
    "The package is removed, so this update cannot be picked up again. The watch keeps the firmware it is running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "パッケージが削除され、このアップデートは再開できなくなります。ウォッチは現在のファームウェアのまま動作します。"
          }
        }
      }
    },
    "The PBW package contains mismatched application identifiers." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PBWパッケージ内のアプリケーション識別子が一致していません。"
          }
        }
      }
    },
    "The PBW package does not contain an application executable." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "PBWパッケージにアプリケーションの実行ファイルが含まれていません。"
