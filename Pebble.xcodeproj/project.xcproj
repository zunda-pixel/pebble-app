{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "ja",
    ],
  },
  "files": [
    { "path": "PebbleKit" },
    {
      "kind": "folder",
      "path": "Pebble",
      "target-membership": [
        "Pebble",
      ],
      "membership-exceptions": [
        {
          "target": "Pebble",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Pebble.app", "id": "000000000000000000000120", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Pebble",
      "id": "000000000000000100000000",
      "product": "Products/Pebble.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "PebbleKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Pebble/Pebble.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "PU5HXZ4FZ2",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_ENHANCED_SECURITY": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "YES",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "YES",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "YES",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Pebble/Info.plist",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "Pebble asks the Music app what is playing so your watch can show it and control it.",
        "INFOPLIST_KEY_NSAppleMusicUsageDescription": "Pebble shows the current song on your watch and lets it control playback.",
        "INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription": "Pebble uses Bluetooth to find, connect to, and synchronize with your watch.",
        "INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription": "Pebble synchronizes upcoming calendar events to your watch timeline.",
        "INFOPLIST_KEY_NSHealthShareUsageDescription": "Pebble reads steps, sleep, energy, distance and exercise minutes so your watch can show the day it has not counted itself.",
        "INFOPLIST_KEY_NSHealthUpdateUsageDescription": "Pebble saves watch steps and sleep data to your Health data when you choose to synchronize.",
        "INFOPLIST_KEY_NSLocationWhenInUseUsageDescription": "Pebble reads your position only to fetch the weather it sends to your watch.",
        "INFOPLIST_KEY_NSRemindersFullAccessUsageDescription": "Pebble sends your reminders to the watch, and adds the ones you make on the watch back here.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Turns what you say to your watch into words. The recording never leaves this phone.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphoneos*]": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation[sdk=iphonesimulator*]": "YES",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphoneos*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UIStatusBarStyle[sdk=iphonesimulator*]": "UIStatusBarStyleDefault",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "LD_RUNPATH_SEARCH_PATHS": "@executable_path/Frameworks",
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": "@executable_path/../Frameworks",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.zunda.Pebble",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator macosx xros xrsimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEAD_CODE_STRIPPING": "YES",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_ENHANCED_SECURITY": "YES",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
    "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "27.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PROJECT_UNIQUE_VALUE": "AFOJ42AQ",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "XROS_DEPLOYMENT_TARGET": "27.0",
  },
  "last-upgrade": "27.0",
  "last-swift-update": "27.0",
}
